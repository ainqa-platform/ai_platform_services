# Postgres connection for the ai_platform schema (see docs/APPLICATION_OVERVIEW.md
# and the approved plan for why this is a direct connection, not the legacy
# /api/postgress/* proxy). Provisioning the real value is a deploy-time/DevOps task.
DATABASE_URL=postgres://ai_platform:ai_platform@localhost:5432/ai_platform

# AES-256-GCM master key for the secrets module, 32 raw bytes, hex-encoded (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_MASTER_KEY=

# JWT verification for the same token format the frontend already decodes via
# safeDecodeJWT (see src/utils/helperFunction.js). If left unset, JwtAuthGuard
# decodes without verifying the signature (matches current frontend behavior)
# and logs a startup warning -- fill this in once IDM's real signing
# key/JWKS endpoint is available.
JWT_VERIFY_KEY=
JWT_ALGORITHM=HS256

PORT=4000
CORS_ORIGIN=http://localhost:3000

# Server-side Langfuse client (keeps the secret key out of the browser bundle,
# closing the gap noted in docs/APPLICATION_OVERVIEW.md section 11).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# ChromaDB connection (see vector-store/providers/chroma.provider.ts), used
# by file_qa usecases with vectorStore.type: "chroma" (the default).
# SECURITY: verified against this instance directly -- it is reachable with
# NO authentication and already shows signs of a ransomware-style attack
# (a collection named "ENCRYPTED_BY_JADEPUFFER"). Firewall this host/port to
# your internal network and set CHROMA_AUTH_TOKEN before trusting it with
# real data -- see the conversation this was flagged in.
CHROMA_URL=http://164.52.211.42:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_AUTH_TOKEN=

# db_search: named Postgres data sources an admin can pick per usecase (see
# usecases/dto/usecase-config.schema.ts `dataSource`). Add one env var per
# source as more are provisioned.
PRIMARYCARENG_SIT_DATABASE_URL=

# ==========================================================================
# MOVED FROM ebm-service-v1 / ebm-service-v3
# Config for the EBM endpoints now served from src/legacy/ (see
# src/legacy/legacy.routes.ts):
#   /api/config, /api/postgress/*   <- ebm-service-v3
#   /api/patients/{callgpt,callpista,postpista}  <- ebm-service-v1
# ==========================================================================

# Upstream chat completion credential used by /api/patients/callgpt.
OPENAI_API_KEY=

# ArangoDB adapter that paramsMapping.js reads runtime params from
# (helpers/paramsMapping.js -> read_qdmqueries).
ADAPTER_URL=
CLIENT_DB_NAME=

# ebm-service-v3's winston logger + error handler.
LOG_LEVEL=info
NODE_ENV=development

# Optional. The legacy Postgres pool reuses DATABASE_URL above; set this only to
# point /api/config and /api/postgress/* at a different database.
EBM_DATABASE_URL=

# Optional. Overrides the 25mb JSON body limit the legacy routes are mounted
# with (discharge-summary payloads exceed Nest's 100kb default).
LEGACY_BODY_LIMIT=
