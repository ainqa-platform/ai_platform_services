# Postgres connection for the ai_platform schema (see docs/APPLICATION_OVERVIEW.md
# and the approved plan for why this is a direct connection, not the legacy
# /api/postgress/* proxy). Provisioning the real value is a deploy-time/DevOps task.
DATABASE_URL=postgres://dev_user:o2o92o2Spa55@164.52.216.181:5433/ai_platform

# AES-256-GCM master key for the secrets module, 32 raw bytes, hex-encoded (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_MASTER_KEY=aec3cd68a96cd42e3993bc9e395750d8e4275eebf898b8aa13b572ab8aa7fd5e

# JWT verification for the same token format the frontend already decodes via
# safeDecodeJWT (see src/utils/helperFunction.js). If left unset, JwtAuthGuard
# decodes without verifying the signature (matches current frontend behavior)
# and logs a startup warning -- fill this in once IDM's real signing
# key/JWKS endpoint is available.
JWT_VERIFY_KEY=
JWT_ALGORITHM=HS256

PORT=4000
CORS_ORIGIN=http://localhost:3000

# Server-side Langfuse client (keeps the secret key out of the browser bundle,
# closing the gap noted in docs/APPLICATION_OVERVIEW.md section 11).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# ChromaDB connection (see vector-store/providers/chroma.provider.ts).
# SECURITY: this instance is reachable with NO authentication and already
# shows signs of a ransomware-style attack ("ENCRYPTED_BY_JADEPUFFER"
# collection). Firewall it and set CHROMA_AUTH_TOKEN before real use.
CHROMA_URL=http://164.52.211.42:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_AUTH_TOKEN=

# db_search: primarycareng_sit (patient/chief-complaints test data).
# SECURITY: reuses the postgres superuser -- no dedicated read-only role
# provisioned yet, see the comment in src/config/configuration.ts.
PRIMARYCARENG_SIT_DATABASE_URL=postgres://postgres:d3V0P5!p5ql@164.52.216.181:5433/primarycareng_sit
 